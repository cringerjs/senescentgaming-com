---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Join">
	<section class="section">
		<div class="wrap narrow">
			<p class="eyebrow">// recruitment</p>
			<h1>Recruitment Status: Closed</h1>

			<p>
				We appreciate the interest — truly. But Senescent Gaming is not
				currently recruiting, scouting, holding tryouts, or accepting
				"just checking if you want to join our league" messages.
			</p>

			<div class="card status-card">
				<p class="mono status-line">ROSTER: FULL</p>
				<p class="mono status-line">TRYOUTS: NONE SCHEDULED</p>
				<p class="mono status-line">DMS ABOUT JOINING: READ, RARELY ANSWERED</p>
			</div>

			<p>
				If you're reaching out because you saw someone repping Senescent
				Gaming and figured they might be free agents — they're not. They
				already play for us. Sorry.
			</p>

			<p class="fine-print">
				This has been the entire recruitment process. Thanks for stopping by.
			</p>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 65ch;
	}

	.narrow p {
		color: var(--muted);
		margin-bottom: 1.25rem;
	}

	.status-card {
		margin: 2rem 0;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.status-line {
		margin: 0;
		font-size: 0.9rem;
	}

	.status-line:first-child {
		color: var(--accent);
	}

	.fine-print {
		font-size: 0.85rem;
		font-style: italic;
	}
</style>
