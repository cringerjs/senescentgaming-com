---
import Layout from '../layouts/Layout.astro';
import OwlMark from '../components/OwlMark.astro';
import { roster } from '../data/roster';

const preview = roster.slice(0, 3);
---

<Layout title="Home">
	<section class="section hero">
		<div class="wrap hero-wrap">
			<div class="hero-copy">
				<p class="eyebrow">// est. before your ISP had a name</p>
				<h1>SENESCENT GAMING</h1>
				<p class="tagline">
					Old enough to remember a 40ms ping. Fast enough to still make it
					hurt.
				</p>
				<div class="hero-actions">
					<span class="badge">Roster: Closed</span>
					<span class="badge">Not Recruiting</span>
				</div>
			</div>
			<OwlMark size={200} class="hero-owl" />
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<p class="eyebrow">// origin</p>
			<h2>We were LAN before it was a lifestyle brand</h2>
			<p class="lede">
				Senescent Gaming started as a handful of players who cut their teeth over
				IPX/SPX and dial-up matchmaking through Kali and GameSpy 3D, back when
				"latency" meant your modem, not your reflexes. We never stopped playing.
				We just got older, slower to warm up, and considerably harder to
				surprise.
			</p>
			<a class="btn" href="/about">Read the full history →</a>
		</div>
	</section>

	<section class="section roster-preview">
		<div class="wrap">
			<p class="eyebrow">// current roster</p>
			<h2>The Lineup</h2>
			<div class="grid">
				{
					preview.map((p) => (
						<div class="card player-card">
							<p class="mono handle">{p.handle}</p>
							<p class="role">{p.role}</p>
							<p class="quote">&ldquo;{p.quote}&rdquo;</p>
						</div>
					))
				}
			</div>
			<a class="btn" href="/roster">View full roster →</a>
		</div>
	</section>

	<section class="section cta">
		<div class="wrap">
			<div class="card cta-card">
				<p class="eyebrow">// recruitment</p>
				<h2>Thinking about asking us to join your team?</h2>
				<p>
					We appreciate it. Genuinely. But the roster's locked for the season,
					and at our age, adjusting to new voice comms is its own training arc.
				</p>
				<a class="btn" href="/join">See recruitment status →</a>
			</div>
		</div>
	</section>
</Layout>

<style>
	.hero {
		padding-top: 5rem;
		padding-bottom: 4rem;
		text-align: left;
		border-bottom: 1px solid var(--line);
	}

	.hero-wrap {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.hero-copy {
		flex: 1;
	}

	.hero-owl {
		color: var(--accent-dim);
		opacity: 0.6;
		flex-shrink: 0;
		filter: drop-shadow(0 0 22px rgba(57, 255, 20, 0.15));
	}

	@media (max-width: 720px) {
		.hero-owl {
			display: none;
		}
	}

	.hero h1 {
		font-family: var(--font-mono);
		font-size: clamp(2.2rem, 6vw, 3.6rem);
		letter-spacing: 0.02em;
		margin: 0 0 1rem;
		color: var(--fg);
		text-shadow: 0 0 18px rgba(57, 255, 20, 0.25);
	}

	.tagline {
		font-size: 1.15rem;
		color: var(--muted);
		max-width: 40ch;
		margin: 0 0 1.75rem;
	}

	.hero-actions {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.lede {
		max-width: 62ch;
		color: var(--muted);
		margin-bottom: 1.5rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 1.25rem;
		margin-bottom: 2rem;
	}

	.player-card .handle {
		color: var(--accent);
		font-size: 1.05rem;
		margin: 0 0 0.25rem;
	}

	.player-card .role {
		color: var(--muted);
		font-size: 0.85rem;
		margin: 0 0 0.9rem;
	}

	.player-card .quote {
		font-style: italic;
		font-size: 0.9rem;
		margin: 0;
	}

	.cta-card h2 {
		margin-top: 0;
	}

	.cta-card p {
		color: var(--muted);
		max-width: 55ch;
	}
</style>
