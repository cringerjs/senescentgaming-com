---
import Layout from '../layouts/Layout.astro';

const entries = [
	{
		name: 'xXx_G0blinSlay3r_xXx',
		date: '1/15/2002 3:47am',
		message:
			'yo this site rules!!! add me on AIM lolz. my sn is in my profile',
	},
	{
		name: 'your mom',
		date: '6/2/2001',
		message:
			"how do i get to the next page. this isn't geocities.com/timessquare/quakeclan its a totally different site",
	},
	{
		name: 'DialUpDave',
		date: '11/9/2003',
		message:
			"downloaded ur roster page while my mom was on the phone. worth it. connection dropped twice but i persevered",
	},
	{
		name: 'l33t_haxx0r_99',
		date: '3/3/2004',
		message: 'sign my guestbook back!!! [link removed by webmaster] :)',
	},
	{
		name: 'A Concerned Parent',
		date: '8/19/2002',
		message:
			'Is this website appropriate for my 14 year old? He has been playing Counter-Strike for 6 hours and will not come down for dinner.',
	},
	{
		name: 'Tristeaal',
		date: 'just now',
		message:
			"Still getting asked to join clans. Made this whole site so I don't have to explain anymore. Working great so far. — the actual webmaster",
	},
];
---

<Layout title="Guestbook">
	<section class="section">
		<div class="wrap narrow">
			<p class="eyebrow">// guestbook</p>
			<h1>Sign Our Guestbook</h1>
			<p class="lede">
				A tradition from an era when websites needed your permission to be
				visited. New entries are closed — GeoCities took the CGI script when
				it died in 2009, and nobody ever rebuilt it. What's below is what
				survived.
			</p>

			<div class="guestbook-meta mono">
				<span>TOTAL SIGNATURES: 47</span>
				<span>LAST SIGNED: SEE BELOW</span>
			</div>

			<div class="entries">
				{
					entries.map((e) => (
						<div class="card entry">
							<div class="entry-head">
								<span class="entry-name">{e.name}</span>
								<span class="entry-date mono">{e.date}</span>
							</div>
							<p class="entry-message">{e.message}</p>
						</div>
					))
				}
			</div>

			<div class="card add-entry">
				<p class="mono add-entry-title">ADD YOUR OWN ENTRY</p>
				<p class="add-entry-note">
					Form disabled. The webmaster is only reachable via dial-up and the
					line is usually busy.
				</p>
			</div>
		</div>
	</section>
</Layout>

<style>
	.narrow {
		max-width: 70ch;
	}

	.lede {
		color: var(--muted);
		margin-bottom: 1.5rem;
	}

	.guestbook-meta {
		display: flex;
		gap: 1.5rem;
		flex-wrap: wrap;
		font-size: 0.75rem;
		color: var(--accent-dim);
		margin-bottom: 2rem;
		padding-bottom: 1rem;
		border-bottom: 1px dashed var(--line);
	}

	.entries {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.entry-head {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
		margin-bottom: 0.5rem;
		flex-wrap: wrap;
	}

	.entry-name {
		color: var(--accent);
		font-weight: 600;
	}

	.entry-date {
		color: var(--muted);
		font-size: 0.75rem;
		white-space: nowrap;
	}

	.entry-message {
		margin: 0;
		color: var(--fg);
		font-size: 0.9rem;
	}

	.add-entry {
		text-align: center;
	}

	.add-entry-title {
		color: var(--muted);
		font-size: 0.8rem;
		margin: 0 0 0.5rem;
	}

	.add-entry-note {
		margin: 0;
		color: var(--muted);
		font-size: 0.85rem;
		font-style: italic;
	}
</style>
