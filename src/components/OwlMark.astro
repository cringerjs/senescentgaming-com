---
interface Props {
	size?: number;
	class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	viewBox="0 0 125 145"
	width={size}
	height={size}
	class={className}
	fill="none"
	stroke="currentColor"
	stroke-width="3"
	stroke-linecap="round"
	stroke-linejoin="round"
	role="img"
	aria-label="Senescent Gaming skeletal owl mark"
>
	<!-- cane -->
	<path d="M96,138 L96,100 Q96,92 88,92" stroke-width="2.3"></path>

	<!-- left ear bone -->
	<path d="M36,26 L40,10 L44,28" stroke-width="2.4"></path>
	<!-- right ear bone, snapped -->
	<path d="M78,28 L80,16 L84,26" stroke-width="2.4"></path>
	<path d="M85,19 L90,21" stroke-width="1.6" opacity="0.7"></path>

	<!-- skull -->
	<circle cx="60" cy="50" r="25"></circle>
	<path d="M45,30 L52,40 L47,50" stroke-width="1.4" opacity="0.75"></path>

	<!-- eye sockets, hollow -->
	<circle cx="50" cy="48" r="9" stroke-width="2.5"></circle>
	<circle cx="50" cy="49" r="1.4" fill="currentColor" stroke="none"></circle>
	<circle cx="72" cy="52" r="9" stroke-width="2.5"></circle>
	<circle cx="72" cy="54" r="1.2" fill="currentColor" stroke="none"></circle>

	<!-- hooked bone beak -->
	<path d="M56,62 L64,62 L61,70 L59,70 Z" stroke-width="2"></path>

	<!-- spine -->
	<path d="M60,75 L60,120" stroke-width="2.6"></path>

	<!-- ribcage -->
	<path d="M60,80 Q45,84 38,78 M60,80 Q75,84 82,78" stroke-width="1.8"></path>
	<path d="M60,88 Q47,93 42,86 M60,88 Q73,93 78,86" stroke-width="1.8"></path>
	<path d="M60,96 Q49,100 46,94 M60,96 Q71,100 74,94" stroke-width="1.8"></path>
	<path d="M60,104 Q52,108 50,102 M60,104 Q68,108 70,102" stroke-width="1.8"></path>

	<!-- pelvis -->
	<path d="M60,120 L54,130 M60,120 L66,130" stroke-width="2"></path>

	<!-- left wing bones -->
	<path d="M42,78 L20,95" stroke-width="2.4"></path>
	<path d="M20,95 L10,82 M20,95 L6,96 M20,95 L10,110" stroke-width="1.5"></path>

	<!-- right wing bones, drooping -->
	<path d="M78,78 L100,100" stroke-width="2.4"></path>
	<path d="M100,100 L112,86 M100,100 L116,102 M100,100 L110,118" stroke-width="1.5"></path>
	<!-- last remaining feather -->
	<g opacity="0.8">
		<path d="M100,100 L104,112" stroke-width="1.3"></path>
		<ellipse cx="105" cy="116" rx="2.4" ry="5" transform="rotate(18 105 116)" stroke-width="1.3"></ellipse>
	</g>

	<!-- legs and bony toes -->
	<path d="M54,120 L50,132" stroke-width="2"></path>
	<path d="M50,132 L44,136 M50,132 L50,138 M50,132 L56,136" stroke-width="1.5"></path>
	<path d="M66,120 L70,132" stroke-width="2"></path>
	<path d="M70,132 L64,136 M70,132 L70,138 M70,132 L76,136" stroke-width="1.5"></path>
</svg>
