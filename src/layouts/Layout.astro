---
import '../styles/global.css';
import OwlMark from '../components/OwlMark.astro';
import { terminalQuotes } from '../data/quotes';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Senescent Gaming — competitive gaming for players who remember what a ping of 40ms felt like.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const nav = [
	{ href: base, label: 'Home' },
	{ href: `${base}roster`, label: 'Roster' },
	{ href: `${base}about`, label: 'About' },
	{ href: `${base}results`, label: 'Hall of Fame' },
	{ href: `${base}join`, label: 'Join' },
];

const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const path = normalize(Astro.url.pathname);
---

<html lang="en">
	<head>
		<script is:inline>
			try {
				if (localStorage.getItem('senescent-1998-mode') === '1') {
					document.documentElement.classList.add('mode-1998');
				}
				if (sessionStorage.getItem('senescent-boot-shown') === '1') {
					document.documentElement.classList.add('boot-skip');
				}
			} catch (e) {}
		</script>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		<link rel="mask-icon" href={`${base}favicon.svg`} color="#39ff14" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title} · Senescent Gaming</title>
	</head>
	<body>
		<div id="boot-sequence" class="boot-sequence" role="status" aria-live="polite">
			<div class="boot-lines">
				<p>SENESCENT BIOS v3.11 &mdash; (C) 1998-2026 Senescent Gaming</p>
				<p>Initializing IPX/SPX driver... OK</p>
				<p>Detecting sound card... Sound Blaster 16 found</p>
				<p>Testing joint mobility... marginal, proceeding anyway</p>
				<p>Memory test... 640K OK (should be enough for anybody)</p>
				<p>Establishing connection to Kali server... OK</p>
				<p>Loading SENESCENTGAMING.COM...</p>
				<p>Checking roster status... CLOSED</p>
				<p class="boot-welcome">WELCOME TO SENESCENT GAMING</p>
			</div>
			<p class="boot-skip-hint">click or press any key to skip</p>
		</div>
		<div class="crt-overlay" aria-hidden="true"></div>
		<div class="marquee-1998" aria-hidden="true">
			<div class="marquee-track">
				*** WELCOME TO SENESCENT GAMING *** THIS SITE IS BEST VIEWED IN NETSCAPE
				NAVIGATOR *** SIGN OUR GUESTBOOK *** UNDER CONSTRUCTION *** HACK THE
				PLANET *** YOU ARE VISITOR NUMBER 001338 *** ROSTER STATUS: CLOSED ***
			</div>
		</div>
		<div class="construction-1998" aria-hidden="true">
			🚧 UNDER CONSTRUCTION — PARDON OUR DUST 🚧
		</div>
		<button
			id="mode-1998-toggle"
			class="mode-1998-toggle"
			type="button"
			aria-label="Toggle 1998 mode"
		>
			🕰 1998 MODE
		</button>
		<nav class="site-nav">
			<div class="wrap">
				<a class="brand" href={base}>
					<OwlMark size={30} class="brand-owl" />
					SENESCENT<span>_</span>GAMING
				</a>
				<input type="checkbox" id="nav-toggle" class="nav-toggle-input" />
				<label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
					<span></span>
					<span></span>
					<span></span>
				</label>
				<ul class="nav-links">
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={
										path === normalize(item.href) ? 'page' : undefined
									}
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</div>
		</nav>

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="wrap footer-meta">
				<span>&copy; {new Date().getFullYear()} Senescent Gaming. Est. sometime before you had broadband.</span>
				<span class="mono">ROSTER STATUS: CLOSED</span>
			</div>
			<div class="wrap">
				<p class="mono footer-quote" id="terminal-quote">&gt; {terminalQuotes[0]}</p>
			</div>
			<div class="wrap">
				<p class="mono visitor-counter" id="visitor-counter" aria-label="Visitor counter (not really tracking you)">
					VISITORS: <span class="counter-digits">0001337</span>
				</p>
			</div>
			<div class="wrap footer-extras">
				<nav class="webring" aria-label="Webring">
					<a href={base} title="There is only one site in this webring.">&larr; PREV</a>
					<span class="webring-label">SENESCENT GAMING WEBRING</span>
					<a href={base} title="There is only one site in this webring.">NEXT &rarr;</a>
				</nav>
				<div class="footer-badges">
					<span class="footer-badge">BEST VIEWED IN NETSCAPE NAVIGATOR AT 800&times;600</span>
					<span class="footer-badge">POWERED BY NOTEPAD AND SPITE</span>
					<a class="footer-badge footer-badge-link" href={`${base}guestbook`}>📖 SIGN OUR GUESTBOOK</a>
				</div>
				<div class="dialup">
					<button id="dialup-btn" class="dialup-btn" type="button">🔌 CONNECT</button>
					<span id="dialup-status" class="mono dialup-status" aria-live="polite"></span>
				</div>
			</div>
		</footer>
		<script define:vars={{ quotes: terminalQuotes }}>
			const el = document.getElementById('terminal-quote');
			if (el && quotes.length) {
				const pick = quotes[Math.floor(Math.random() * quotes.length)];
				el.textContent = `> ${pick}`;
			}

			try {
				const key = 'senescent-visitor-count';
				const base = 1337;
				const count = base + parseInt(localStorage.getItem(key) || '0', 10) + 1;
				localStorage.setItem(key, String(count - base));
				const digitsEl = document.querySelector('.counter-digits');
				if (digitsEl) {
					digitsEl.textContent = String(count).padStart(7, '0');
				}
			} catch (e) {
				// localStorage unavailable — the counter just stays at its default. Fine.
			}

			console.log(
				'%c SENESCENT GAMING ',
				'background:#0a0d0a;color:#39ff14;font-family:monospace;font-size:16px;padding:6px 10px;border:1px solid #39ff14;'
			);
			console.log(
				'%cHack the planet. Or at least the thermostat.',
				'color:#39ff14;font-family:monospace;font-size:12px;'
			);
			console.log(
				'%cYou found the console. We\'re still not recruiting.',
				'color:#7c9a86;font-family:monospace;font-size:12px;'
			);

			const bootOverlay = document.getElementById('boot-sequence');
			if (bootOverlay) {
				let alreadyShown = false;
				try {
					alreadyShown = sessionStorage.getItem('senescent-boot-shown') === '1';
				} catch (e) {}
				if (alreadyShown) {
					bootOverlay.remove();
				} else {
					const dismissBoot = () => {
						bootOverlay.classList.add('boot-hidden');
						setTimeout(() => bootOverlay.remove(), 450);
						try {
							sessionStorage.setItem('senescent-boot-shown', '1');
						} catch (e) {}
						document.removeEventListener('keydown', dismissBoot);
						bootOverlay.removeEventListener('click', dismissBoot);
					};
					bootOverlay.addEventListener('click', dismissBoot);
					document.addEventListener('keydown', dismissBoot);
					setTimeout(dismissBoot, 4200);
				}
			}

			const html = document.documentElement;
			const toggleBtn = document.getElementById('mode-1998-toggle');
			const applyMode1998 = (on) => {
				html.classList.toggle('mode-1998', on);
				if (toggleBtn) {
					toggleBtn.textContent = on ? '↩ BACK TO NORMAL' : '🕰 1998 MODE';
				}
			};
			applyMode1998(html.classList.contains('mode-1998'));
			if (toggleBtn) {
				toggleBtn.addEventListener('click', () => {
					const next = !html.classList.contains('mode-1998');
					applyMode1998(next);
					try {
						localStorage.setItem('senescent-1998-mode', next ? '1' : '0');
					} catch (e) {}
				});
			}

			const dialupBtn = document.getElementById('dialup-btn');
			const dialupStatus = document.getElementById('dialup-status');
			if (dialupBtn) {
				dialupBtn.addEventListener('click', () => {
					const AudioCtx = window.AudioContext || window.webkitAudioContext;
					if (!AudioCtx) return;
					dialupBtn.disabled = true;
					if (dialupStatus) dialupStatus.textContent = 'DIALING...';

					const ctx = new AudioCtx();
					const now = ctx.currentTime;
					const freqs = [
						350, 440, 620, 1200, 2100, 1800, 2400, 1600, 2600, 900, 1400, 2000,
					];
					let t = now;
					freqs.forEach((f, i) => {
						const osc = ctx.createOscillator();
						const gain = ctx.createGain();
						osc.type = i % 2 === 0 ? 'square' : 'sawtooth';
						osc.frequency.setValueAtTime(f, t);
						gain.gain.setValueAtTime(0.06, t);
						gain.gain.exponentialRampToValueAtTime(0.001, t + 0.15);
						osc.connect(gain).connect(ctx.destination);
						osc.start(t);
						osc.stop(t + 0.18);
						t += 0.14 + Math.random() * 0.06;
					});
					const osc2 = ctx.createOscillator();
					const gain2 = ctx.createGain();
					osc2.type = 'sine';
					osc2.frequency.setValueAtTime(1000, t);
					gain2.gain.setValueAtTime(0.08, t);
					gain2.gain.exponentialRampToValueAtTime(0.001, t + 0.4);
					osc2.connect(gain2).connect(ctx.destination);
					osc2.start(t);
					osc2.stop(t + 0.4);

					const totalMs = (t - now + 0.4) * 1000;
					const speeds = [
						'14.4 KBPS',
						'28.8 KBPS',
						'33.6 KBPS',
						'56K (ON A GOOD DAY)',
					];
					setTimeout(() => {
						const speed = speeds[Math.floor(Math.random() * speeds.length)];
						if (dialupStatus) dialupStatus.textContent = `CONNECTED AT ${speed}`;
						dialupBtn.disabled = false;
						ctx.close();
					}, totalMs + 150);
				});
			}
		</script>
	</body>
</html>
